# Files excluded from the wp.org build. This plugin is self-contained with no
# runtime Composer dependencies, so /vendor (dev tooling only) is excluded and
# the bundled src/ PSR-4 autoloader fallback is used.
/.git
/vendor
/.github
/.gitignore
/.distignore
/.wp-env.json
/.wp-env.override.json
/node_modules
/tests
/scripts
/docs
/composer.json
/composer.lock
/package.json
/package-lock.json
/phpcs.xml.dist
/phpstan.neon.dist
/phpstan-baseline.neon
/playwright.config.ts
/tsconfig.json
/vite.config.ts
/README.md
/SPEC.md
/.DS_Store

.DS_Store
/.wordpress-org
/test-results
/playwright-report
/.playwright-mcp
/glotpress-import

# editor backups (never ship / never a badly_named_files reject)
*~
*.bak

# wordpress.org builds language packs from translate.wordpress.org, so a
# catalogue in the package is a duplicate at best, and a bundled .mo shadows the
# pack, meaning a translation corrected upstream never reaches these users until
# the next release. Reel was pended for shipping these. Exclude by FILE TYPE,
# never locale by locale: a per-locale list rots the moment a new locale appears,
# which is exactly how polski-bel.mo walked through a rule naming polski-be_BY.
languages/*.po
languages/*.mo
languages/*.json
languages/*.l10n.php
languages/*.po~
